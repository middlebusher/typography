{
  "typography": {
    "fontFamilies": {
      "regular": {
        "$value": "Inter Variable",
        "$type": "fontFamily",
        "fallbacks": "SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif"
      },
      "serifDisplay": {
        "$value": "Tiempos Headline",
        "$type": "fontFamily",
        "fallbacks": "ui-serif, Georgia, Cambria, Times New Roman, serif"
